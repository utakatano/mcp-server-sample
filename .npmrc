# サプライチェーン攻撃対策。npm install / npm ci のたびに効く。
# 詳細と、依存を更新するときの手順は README を参照。

# インストール時に依存パッケージのライフサイクルスクリプト（postinstall など）を実行しない。
# npm start / npm run は従来どおり動く（pre / post スクリプトだけが走らなくなる）。
ignore-scripts=true

# npm install <pkg> で package.json に書かれるバージョンを完全固定にする（^ を付けない）。
save-exact=true

# 公開から7日を過ぎたバージョンだけをインストールする。
# 乗っ取られた直後の版を掴まないための待機期間（npm 11.12.1 で動作確認）。
min-release-age=7
